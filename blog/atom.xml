    <link href="https://hsiao.chendermatologist.com/blog/diabetic-retinopathy-dementia-trinetx-cohort" rel="alternate" />
    <link href="https://hsiao.chendermatologist.com/en/blog/diabetic-retinopathy-dementia-trinetx-cohort" rel="alternate" hreflang="en" />
