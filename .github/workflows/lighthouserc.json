{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "skipAudits": ["uses-http2", "is-on-https", "redirects-http"],
        "throttling": {
          "cpuSlowdownMultiplier": 1
        }
      }
    },
    "assert": {
      "preset": "lighthouse:no-pwa",
      "assertions": {
        "categories:performance":     ["warn",  { "minScore": 0.80 }],
        "categories:accessibility":   ["warn",  { "minScore": 0.85 }],
        "categories:best-practices":  ["warn",  { "minScore": 0.80 }],
        "categories:seo":             ["warn",  { "minScore": 0.90 }],

        "first-contentful-paint":     ["warn",  { "maxNumericValue": 2000, "aggregationMethod": "median" }],
        "largest-contentful-paint":   ["warn",  { "maxNumericValue": 3500, "aggregationMethod": "median" }],
        "cumulative-layout-shift":    ["warn",  { "maxNumericValue": 0.15, "aggregationMethod": "median" }],
        "total-blocking-time":        ["warn",  { "maxNumericValue": 400,  "aggregationMethod": "median" }],
        "interaction-to-next-paint":  ["warn",  { "maxNumericValue": 400,  "aggregationMethod": "median" }],

        "uses-rel-preconnect":        "off",
        "uses-rel-preload":           "off",
        "preload-fonts":              "off",
        "csp-xss":                    "off",
        "third-party-cookies":        "off",
        "color-contrast":             "off",
        "valid-source-maps":          "off",
        "deprecations":               "off"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
